# Orígenes que ve el navegador. Al servir por HTTPS cambia también COOKIE_SECURE.
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
# Claves independientes. scripts/preparar.py genera ambas y las contraseñas.
APP_KEY=
JWT_SECRET=
# MySQL usa estas variables al inicializar el volumen vacío.
MYSQL_DATABASE=mercado
MYSQL_USER=mercado
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Stripe en modo de prueba. La clave publicable se incorpora al compilar Next.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Estas dos credenciales se pasan solo a Laravel.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
