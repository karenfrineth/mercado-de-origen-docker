  "components": {
    "schemas": {
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "cliente@example.org"
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 72,
            "example": "Ejemplo-local-2026"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Register": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "cliente@example.org"
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 72,
            "example": "Ejemplo-local-2026",
            "minLength": 12
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "cliente@example.org"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "Token": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "example": 3600
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ]
      },
      "ProductInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "example": "Café de Apaneca"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "example": "Bolsa de 340 g."
          },
          "price_cents": {
            "type": "integer",
            "minimum": 50,
            "maximum": 99999999,
            "example": 950
          }
        },
        "required": [
          "name",
          "description",
          "price_cents"
        ]
      },
      "ProductPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "example": "Café de Apaneca"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "example": "Bolsa de 340 g."
          },
          "price_cents": {
            "type": "integer",
            "minimum": 50,
            "maximum": 99999999,
            "example": 950
          }
        },
        "minProperties": 1
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "example": "Café de Apaneca"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "example": "Bolsa de 340 g."
          },
          "price_cents": {
            "type": "integer",
            "minimum": 50,
            "maximum": 99999999,
            "example": 950
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "price_cents",
          "created_at",
          "updated_at"
        ]
      },
      "OrderInput": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "format": "uuid",
            "example": "4ed1e471-4b75-4567-bb45-1cb98b5b7c26"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "product_id",
                "quantity"
              ]
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "reference",
          "items"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "order_id": {
            "type": "integer",
            "minimum": 1
          },
          "product_id": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "name": {
            "type": "string"
          },
          "unit_cents": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "order_id",
          "product_id",
          "quantity",
          "name",
          "unit_cents"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "reference": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid"
            ]
          },
          "total_cents": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "reference",
          "user_id",
          "status",
          "total_cents",
          "items",
          "created_at",
          "updated_at"
        ]
      },
      "Intent": {
        "type": "object",
        "properties": {
          "payment_id": {
            "type": "string",
            "format": "uuid"
          },
          "intent_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string",
            "description": "Solo para el titular de la compra."
          },
          "status": {
            "type": "string"
          },
          "amount": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "usd"
            ]
          }
        },
        "required": [
          "payment_id",
          "intent_id",
          "client_secret",
          "status",
          "amount",
          "currency"
        ]
      },
      "StripeEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "enum": [
              "event"
            ]
          },
          "type": {
            "type": "string",
            "example": "payment_intent.succeeded"
          },
          "data": {
            "type": "object",
            "properties": {
              "object": {
                "type": "object",
                "additionalProperties": true,
                "description": "PaymentIntent de Stripe; el evento de éxito incluye metadata.payment_id, metadata.order_id, amount_received, currency y status."
              }
            },
            "required": [
              "object"
            ]
          }
        },
        "required": [
          "id",
          "object",
          "type",
          "data"
        ]
      },
      "Ack": {
        "type": "object",
        "properties": {
          "received": {
            "type": "boolean"
          }
        },
        "required": [
          "received"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "status",
              "message",
              "details"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "securitySchemes": {
      "bearerJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}