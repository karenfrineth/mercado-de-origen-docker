        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StripeEvent"
              }
            }
          }
        },
        "description": "Stripe firma el cuerpo original. Los eventos distintos de payment_intent.succeeded se reconocen sin cambiar la orden.",
        "parameters": [
          {
            "name": "Stripe-Signature",
            "in": "header",
            "required": true,
            "schema": {
