APP_NAME=Tienda
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
# Base MySQL vacía y usuario con permisos de migración.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tienda
DB_USERNAME=tienda
DB_PASSWORD=
CACHE_STORE=database
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
# Crear con php artisan tienda:jwt-key; clave independiente de APP_KEY.
JWT_SECRET=
# Panel de Stripe en modo prueba; secreto del servidor y firma del endpoint.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
